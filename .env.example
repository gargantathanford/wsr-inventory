# Copy this file to `.env` (or set these as real environment variables / an
# EnvironmentFile in your systemd unit) before starting the app in production.
# See DEPLOYMENT.md for the full deployment walkthrough.

# REQUIRED in production. The app refuses to start without this set (see
# instrumentation.ts). Generate a real one with:
#   openssl rand -base64 48
# Never commit a real value to source control, and never reuse the value
# below — it is the publicly-known development placeholder.
SESSION_SECRET=warp-speed-racing-dev-secret-change-me

# Required for secure cookies and startup validation to activate.
NODE_ENV=production

# Port the Next.js server listens on. The reverse proxy (Caddy/nginx) should
# forward the public subdomain to this port on localhost.
PORT=3000
